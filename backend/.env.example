# ── 数据库配置 ──────────────────────────────────────────────
# 数据库类型: sqlite 或 postgresql
DATABASE_TYPE=sqlite
# SQLite 文件名（相对于项目根目录）
SQLITE_FILE=medical_reports.db
# PostgreSQL 连接 URL（如果使用 PostgreSQL）
DATABASE_URL=postgresql://user:password@localhost:5432/medical_reports

# ── JWT 配置 ─────────────────────────────────────────────────
# JWT 密钥（生产环境必须修改为强随机字符串，至少 32 字符）
JWT_SECRET_KEY=your-secret-key-change-this-in-production-min-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ── 认证配置 ─────────────────────────────────────────────────
NONCE_EXPIRATION_MINUTES=5
SIWE_DOMAIN=localhost:5173
SIWE_URI=http://localhost:5173

# ── Supabase 配置 ────────────────────────────────────────────
SUPABASE_PUBLIC_KEY=your-supabase-public-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_PROJ_URL=https://xxx.supabase.co

# ── S3 存储配置 ──────────────────────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
BUCKET_NAME=medical-reports
STORAGE_TYPE=local

# ── AI 模型配置 ──────────────────────────────────────────────
MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_ID=gpt-4
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL_ID=claude-3-opus-20240229
